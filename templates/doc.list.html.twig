{% extends "layout.html.twig" %}

{% import _self as macros %}

{% block content %}
    <div id="searchbar" class="clearfix">
        <div id="docsearch"></div>
    </div>

    <h1>Book</h1>
    <ul>
        {% for filename, data in book %}
            {{ macros.renderFile(filename, data) }}
        {% endfor %}
    </ul>

    <h1>Articles</h1>
    <ul>
        {% for filename, data in articles %}
            {{ macros.renderFile(filename, data) }}
        {% endfor %}
    </ul>

    <h1>FAQs</h1>
    <ul>
        {% for filename, data in faqs %}
            {{ macros.renderFile(filename, data) }}
        {% endfor %}
    </ul>

    <h1>API Docs</h1>
    <p>If you need to work with composer as a library you may also want to check out the
        <a href="https://github.com/composer/composer/tree/HEAD/src/Composer" title="Go to the source browser" aria-label="Go to the source browser">
            source
        </a>
    </p>

    <h1>For LLMs</h1>
    <p>The documentation is also available as markdown: see
        <a href="{{ path('llms_txt') }}" title="Index of the documentation in markdown" aria-label="Index of the documentation in markdown">llms.txt</a>
        for an index, or
        <a href="{{ path('llms_full_txt') }}" title="The whole documentation as a single markdown file" aria-label="The whole documentation as a single markdown file">llms-full.txt</a>
        for all of it in a single file. Every page can also be fetched as markdown by appending <code>.md</code> to its URL.
    </p>

    <h1>Translations</h1>
    <p>The Composer documentation is also available in other languages:</p>
    <ul>
      <li>
        <a href="https://phpusers-ja.github.io/composer/">Japanese</a>: Getting Started guide (Book) is fully translated. Selected Articles and FAQs are also available.
      </li>
      <li>
        <a href="https://pt.docs.dev.br/tech/c/composer/index.html">Brazilian Portuguese</a>: Translation of the documentation and other resources.
      </li>
    </ul>
{% endblock %}

{% macro renderFile(filename, data) %}
    <li>
        <a href="{{ path('docs.view', {page: data.page}) }}" title="Go to documentation section: {{ filename }}"
           aria-label="Link to documentation section: {{ filename }}">
            {{ filename }}
        </a>
        {% if data.metadata is defined and data.metadata.tagline is defined %}
            <span class="tagline">{{ data.metadata.tagline }}</span>
        {% endif %}
    </li>
{% endmacro %}
